<section id="contact" class="card">


            <p class="mb-2 text-sm font-bold uppercase tracking-widest text-red-700 dark:text-yellow-300">
                Let's Connect
            </p>


            <h2 class="title">Let's Build Together!</h2>


            <p class="mb-6 leading-7">
                Do you have a question, suggestion, or project idea?
                Feel free to contact me using the form below. I'd be happy
                to hear from you!
            </p>


            <form action="#" method="post" class="flex flex-col gap-3">


                <label for="name" class="font-semibold">Name</label>


                <input
                    type="text"
                    id="name"
                    name="name"
                    placeholder="Enter your name"
                    class="input-field"
                    required>


                <label for="email" class="font-semibold">Email</label>


                <input
                    type="email"
                    id="email"
                    name="email"
                    placeholder="Enter your email"
                    class="input-field"
                    required>


                <label for="message" class="font-semibold">Message</label>


                <textarea
                    id="message"
                    name="message"
                    rows="5"
                    placeholder="Write your message here..."
                    class="input-field"
                    required></textarea>


                <button type="submit" class="btn-primary mt-3">
                    Send Message
                </button>


            </form>


            <div class="mt-8 border-t border-red-300 pt-5 dark:border-slate-600">


                <h3 class="font-bold text-red-800 dark:text-orange-400">
                    Email Me Directly
                </h3>


                <a
                    href="mailto:c20245418.yulo@csav.edu.ph"
                    class="mt-2 inline-block break-all underline underline-offset-4">
                    c20245418.yulo@csav.edu.ph
                </a>


            </div>


        </section>